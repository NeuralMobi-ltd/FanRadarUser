%% FanRadars Core Domain Class Diagram
classDiagram
  class User {
    +int id
    +string username
    +string email
    +string role
    +string first_name
    +string last_name
    +date date_naissance
    +string profile_image
    +login()
    +follow(User)
  }

  class Fandom {
    +int id
    +string name
    +string handle
    +string description
    +int members_count
    +join(User)
    +leave(User)
  }

  class Post {
    +int id
    +string content
    +datetime createdAt
    +int likes
    +int comments
    +create()
    +like(User)
    +addComment(Comment)
  }

  class Comment {
    +int id
    +string content
    +datetime createdAt
  }

  class Product {
    +int id
    +string name
    +float price
    +string currency
    +int stock
  }

  class Order {
    +int id
    +string status
    +float total
    +place()
    +cancel()
  }

  class CartItem {
    +int id
    +int quantity
    +float unit_price
  }

  class Notification {
    +int id
    +string type
    +json data
    +datetime created_at
    +boolean read
    +markRead()
  }

  class Hashtag {
    +int id
    +string tag
    +int uses
  }

  User "1" -- "*" Post : author
  User "1" -- "*" Comment : author
  Post "1" -- "*" Comment : comments
  Fandom "1" -- "*" Post : posts
  Fandom "*" -- "*" User : members
  User "*" -- "*" User : follows
  User "1" -- "*" Notification : notifications
  User "1" -- "*" Order : orders
  Order "1" -- "*" CartItem : items
  Product "1" -- "*" CartItem : in
  Post "*" -- "*" Hashtag : tags
