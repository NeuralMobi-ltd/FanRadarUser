%% FanRadar Simplified Core
classDiagram
  class User {
    +id:int
    +first_name:string
    +last_name:string
    +email:string
    +profile_image:string?
    +follow(userId)
    +unfollow(userId)
  }

  class Fandom {
    +id:int
    +name:string
    +description:string?
    +members_count:int
    +join()
  }

  class Post {
    +id:int
    +description:string?
    +media:string[]  // URLs
    +tags:string[]
    +created_at:datetime
    +addComment()
    +favorite()
  }

  class Comment {
    +id:int
    +content:string
    +created_at:datetime
  }

  class Hashtag {
    +id:int
    +tag:string
  }

  class Product {
    +id:int
    +name:string
    +price:number
    +stock:int
  }

  class Order {
    +id:int
    +status:string
    +total:number
  }

  class CartItem {
    +id:int
    +quantity:int
    +unit_price:number
  }

  class Notification {
    +id:int
    +type:string
    +read:boolean
  }

  User "1" -- "*" Post : creates
  User "1" -- "*" Comment : writes
  Post "1" -- "*" Comment : has
  Fandom "1" -- "*" Post : hosts
  Fandom "*" -- "*" User : members
  User "*" -- "*" User : follows
  Post "*" -- "*" Hashtag : tags
  User "1" -- "*" Notification : receives
  User "1" -- "*" Order : places
  Order "1" -- "*" CartItem : items
  Product "1" -- "*" CartItem : referenced