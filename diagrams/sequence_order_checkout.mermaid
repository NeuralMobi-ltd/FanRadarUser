%% Simplified Order Checkout Sequence
sequenceDiagram
  autonumber
  participant U as User
  participant FE as Frontend
  participant API as Laravel API
  participant DB as DB
  U->>FE: Checkout
  FE->>API: POST /api/store/orders
  API->>DB: Validate stock
  alt Insufficient
    API-->>FE: 409 { message }
  else OK
    API->>DB: Insert order + items
    DB-->>API: Order id
    API-->>FE: 201 { order }
  end
  FE->>U: Show confirmation
