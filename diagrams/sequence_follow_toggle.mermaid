%% Sequence Diagram: Follow Toggle
sequenceDiagram
  autonumber
  participant U as Utilisateur (auth)
  participant FE as Frontend
  participant API as API Laravel
  participant DB as DB
  participant NTF as Notifications

  U->>FE: Clic "Suivre"
  FE->>API: POST /api/users/{id}/follow (token)
  API->>DB: Vérifie relation follow
  alt Non existante
    DB-->>API: none
    API->>DB: CREATE follow
    API-->>FE: { following:true, follower_count: +1 }
    API->>NTF: Emit follow.created
  else Existe déjà
    API->>DB: DELETE follow
    API-->>FE: { following:false, follower_count: -1 }
  end
  FE->>U: Met à jour bouton + compteur
