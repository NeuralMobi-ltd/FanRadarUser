%% FanRadars Use Case Diagram
%% Actors: Utilisateur, Créateur, Modérateur, Admin, Système Paiement, Service Notification

%% Title: FanRadars - Diagramme de Cas d'Utilisation

%% Mermaid does not natively support classic UML use case, we emulate via graph
graph TB
  subgraph Actors
    A[Utilisateur]:::actor
    C[Créateur]:::actor
    M[Modérateur]:::actor
    AD[Admin]:::actor
    P[(Système Paiement)]:::external
    N[(Service Notifications)]:::external
  end

  subgraph UseCases
    UC1((S'inscrire))
    UC2((Se connecter))
    UC3((Gérer profil))
    UC4((Parcourir fil))
    UC5((Publier post))
    UC6((Joindre fandom))
    UC7((Interagir: like / commenter))
    UC8((Suivre utilisateur))
    UC9((Rechercher contenus))
    UC10((Voir tendances))
    UC11((Ajouter produit au panier))
    UC12((Passer commande))
    UC13((Consulter commandes))
    UC14((Recevoir notifications))
    UC15((Modérer contenus))
    UC16((Gérer utilisateurs))
    UC17((Configurer catégories/fandoms))
    UC18((Analyser métriques))
  end

  %% Relations acteurs -> cas
  A --> UC1
  A --> UC2
  A --> UC3
  A --> UC4
  A --> UC6
  A --> UC7
  A --> UC8
  A --> UC9
  A --> UC10
  A --> UC11
  A --> UC12
  A --> UC13
  A --> UC14

  C --> UC5
  C --> UC7
  C --> UC9
  C --> UC10

  M --> UC15
  M --> UC10
  M --> UC18

  AD --> UC16
  AD --> UC17
  AD --> UC18

  P --> UC12
  N --> UC14

  classDef actor fill:#f5f5f5,stroke:#555,stroke-width:1px;
  classDef external fill:#e3f2fd,stroke:#1976d2;
