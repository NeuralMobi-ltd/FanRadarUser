%% Diagramme de cas d'utilisation (langage simplifié - français)
graph TB
  A[Utilisateur]:::actor
  subgraph Fonctionnalités
    UC1((S'inscrire))
    UC2((Se connecter))
    UC3((Gérer profil))
    UC4((Voir fil d'accueil))
    UC5((Créer publication))
    UC6((Rejoindre fandom))
    UC7((Commenter / Aimer))
    UC8((Suivre / Se désabonner))
    UC9((Rechercher))
    UC10((Voir posts d'un fandom))
    UC11((Panier & Commander))
    UC12((Recevoir notifications))
  end
  A --> UC1
  A --> UC2
  A --> UC3
  A --> UC4
  A --> UC5
  A --> UC6
  A --> UC7
  A --> UC8
  A --> UC9
  A --> UC10
  A --> UC11
  A --> UC12
  classDef actor fill:#fafafa,stroke:#555,stroke-width:1px,font-weight:bold;
  classDef default stroke:#666,fill:#ffffff;